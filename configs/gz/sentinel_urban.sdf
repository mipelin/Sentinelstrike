    <!-- Perimeter walls for enclosed test area -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 40 5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>100 1 10</size></box></geometry>
