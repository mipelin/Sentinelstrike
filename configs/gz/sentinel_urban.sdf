<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <world name="sentinel_urban">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- No world-level plugins — PX4 loads them via server.config at runtime -->

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.6 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.5 0.5 0.45 1</ambient>
            <diffuse>0.5 0.5 0.45 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- Building 1: Tall office tower -->
    <model name="building_1">
      <static>true</static>
      <pose>20 15 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 8 30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 8 30</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
            <specular>0.9 0.9 0.95 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building 2: Wide warehouse -->
    <model name="building_2">
      <static>true</static>
      <pose>-15 25 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 12 8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 12 8</size></box></geometry>
          <material>
            <ambient>0.55 0.5 0.45 1</ambient>
            <diffuse>0.65 0.6 0.55 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building 3: Residential block -->
    <model name="building_3">
      <static>true</static>
      <pose>10 -20 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 6 12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 6 12</size></box></geometry>
          <material>
            <ambient>0.7 0.65 0.55 1</ambient>
            <diffuse>0.8 0.75 0.65 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building 4: Low structure -->
    <model name="building_4">
      <static>true</static>
      <pose>-20 -10 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 10 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 10 5</size></box></geometry>
          <material>
            <ambient>0.5 0.55 0.5 1</ambient>
            <diffuse>0.6 0.65 0.6 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building 5: Tower -->
    <model name="building_5">
      <static>true</static>
      <pose>-8 -30 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 5 20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 5 20</size></box></geometry>
