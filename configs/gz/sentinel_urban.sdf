    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-40 0 5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 80 10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 80 10</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
