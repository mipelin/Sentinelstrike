    <!-- ======================== CAMERA VALIDATION CLUSTER ======================== -->
    <!-- Group of people and a parked vehicle near intersection for                  -->
    <!-- detection/tracking validation from drone at 15-25m altitude.                -->
    <!-- Located on north sidewalk around X=3..8, Y=8..9 — directly below           -->
    <!-- typical drone hover position at (5, 0, 20).                                -->
    <!-- Spacing 1.5-2.5m apart so YOLO resolves full bodies as separate detections.-->

    <!-- Male visitor in validation cluster, facing south (toward camera) -->
    <include>
      <name>person_val_1</name>
      <pose>4 9 0 0 0 -1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor</uri>
    </include>

    <!-- Female visitor in validation cluster -->
    <include>
      <name>person_val_2</name>
      <pose>5.5 9 0 0 0 -1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FemaleVisitor</uri>
    </include>

    <!-- Male visitor in validation cluster (slightly offset) -->
    <include>
      <name>person_val_3</name>
      <pose>7 8.5 0 0 0 -1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor</uri>
    </include>

    <!-- Walking person in validation cluster (static mid-stride pose) -->
    <include>
      <name>person_val_4</name>
      <pose>8.5 9 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
    </include>

    <!-- Female visitor in validation cluster -->
    <include>
      <name>person_val_5</name>
      <pose>3 8.5 0 0 0 0.78</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FemaleVisitor</uri>
    </include>
    <!-- ======================== MOVING VEHICLES (Fuel models, moved by traffic script) ======================== -->
    <!-- Z=0 for all. Initial yaw = desired_heading - internal_yaw.                    -->
    <!-- Traffic script computes effective_yaw = heading + yaw_offset, where            -->
    <!--   yaw_offset = -internal_yaw.                                                  -->
    <!--                                                                                -->
    <!-- Corrected internal_yaw values (from model.sdf audit):                          -->
    <!--   Pickup=0, Hatchback=0, Prius=-π/2, TruckBox=0                               -->

    <!-- Pickup moving east along south lane (internal_yaw=0, initial yaw=0-0=0) -->
    <include>
      <name>vehicle_moving_1</name>
      <pose>-50 -2.5 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
    </include>

    <!-- Hatchback moving west along north lane (internal_yaw=0, initial yaw=π-0=π) -->
    <include>
      <name>vehicle_moving_2</name>
      <pose>50 2.5 0 0 0 3.14</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
    </include>

    <!-- Prius moving slow east (internal_yaw=-π/2, initial yaw=0-(-π/2)=π/2) -->
    <include>
      <name>vehicle_moving_3</name>
      <pose>-30 -3.5 0 0 0 1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid with sensors</uri>
    </include>

    <!-- TruckBox moving west (internal_yaw=0, initial yaw=π-0=π) -->
    <include>
      <name>vehicle_moving_4</name>
      <pose>40 3.5 0 0 0 3.14</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TruckBox</uri>
    </include>

    <!-- ======================== OBSTACLES ======================== -->

    <!-- Traffic barrier -->
    <model name="barrier_1">
      <static>true</static>
      <pose>5 5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.3 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.3 0.7</size></box></geometry>
          <material>
            <ambient>0.9 0.6 0.0 1</ambient>
            <diffuse>1.0 0.7 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Traffic barrier 2 -->
    <model name="barrier_2">
      <static>true</static>
      <pose>5 5.5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.5 0.3 0.7</size></box></geometry>
          <material>
            <ambient>0.9 0.6 0.0 1</ambient>
            <diffuse>1.0 0.7 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dumpster -->
    <model name="dumpster">
      <static>true</static>
      <pose>-25 -9 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 1.2 1.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.2 1.4</size></box></geometry>
          <material>
            <ambient>0.15 0.4 0.15 1</ambient>
            <diffuse>0.2 0.5 0.2 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Concrete jersey barrier -->
    <model name="jersey_barrier">
      <static>true</static>
      <pose>15 5.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.5 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.5 0.8</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.58 1</ambient>
            <diffuse>0.7 0.7 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trash can -->
    <model name="trash_can">
      <static>true</static>
      <pose>12 8.5 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== SIGNS / MARKERS ======================== -->

    <!-- Stop sign (red octagon approximated by cylinder) -->
    <model name="stop_sign">
      <static>true</static>
      <pose>-4 5 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
        <visual name="sign">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.0 0.0 1</ambient>
            <diffuse>0.9 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Traffic light post -->
    <model name="traffic_light">
      <static>true</static>
      <pose>4.5 5 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>5.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="housing">
          <pose>0 0 4.8 0 0 0</pose>
          <geometry><box><size>0.4 0.15 1.0</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="light_red">
          <pose>0 -0.08 5.1 0 0 0</pose>
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>1.0 0.1 0.1 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse><emissive>0.8 0.0 0.0 1</emissive></material>
        </visual>
        <visual name="light_yellow">
          <pose>0 -0.08 4.85 0 0 0</pose>
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.9 0.9 0.2 1</diffuse></material>
        </visual>
        <visual name="light_green">
          <pose>0 -0.08 4.6 0 0 0</pose>
          <geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.2 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Street lamp 1 -->
    <model name="lamp_1">
      <static>true</static>
      <pose>-10 6 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 3.0 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>6.0</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <visual name="arm">
          <pose>0.8 0 5.8 0 0 0</pose>
          <geometry><box><size>1.6 0.08 0.08</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <visual name="lamp_head">
          <pose>1.5 0 5.7 0 0 0</pose>
          <geometry><box><size>0.4 0.3 0.1</size></box></geometry>
          <material><ambient>0.9 0.9 0.8 1</ambient><diffuse>1.0 1.0 0.9 1</diffuse><emissive>0.4 0.4 0.3 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Street lamp 2 -->
    <model name="lamp_2">
      <static>true</static>
      <pose>10 -6 0 0 0 0</pose>
      <link name="link">
        <visual name="pole">
          <pose>0 0 3.0 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>6.0</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <visual name="arm">
          <pose>-0.8 0 5.8 0 0 0</pose>
          <geometry><box><size>1.6 0.08 0.08</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
        <visual name="lamp_head">
          <pose>-1.5 0 5.7 0 0 0</pose>
          <geometry><box><size>0.4 0.3 0.1</size></box></geometry>
          <material><ambient>0.9 0.9 0.8 1</ambient><diffuse>1.0 1.0 0.9 1</diffuse><emissive>0.4 0.4 0.3 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Tree 1 (trunk + canopy) -->
    <model name="tree_1">
      <static>true</static>
      <pose>-8 9 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.15 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 3.8 0 0 0</pose>
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
          <material><ambient>0.15 0.4 0.1 1</ambient><diffuse>0.2 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree 2 -->
    <model name="tree_2">
      <static>true</static>
      <pose>15 9 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>3.6</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.15 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.2 0 0 0</pose>
          <geometry><sphere><radius>1.8</radius></sphere></geometry>
          <material><ambient>0.15 0.4 0.1 1</ambient><diffuse>0.2 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree 3 -->
    <model name="tree_3">
      <static>true</static>
      <pose>30 -9 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.15 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 3.4 0 0 0</pose>
          <geometry><sphere><radius>1.3</radius></sphere></geometry>
          <material><ambient>0.15 0.4 0.1 1</ambient><diffuse>0.2 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ======================== LIGHTING ======================== -->

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.2</intensity>
      <direction>0.3 0.5 -0.8</direction>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.5 0.5 0.45 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- Fill light for better visibility from drone altitude -->
    <light name="fill_light" type="directional">
      <pose>0 0 300 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.4</intensity>
      <direction>-0.2 -0.3 -0.9</direction>
      <diffuse>0.8 0.85 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
