<?xml version="1.0" encoding="UTF-8"?>
<!-- SCENE_DENSITY: heavy (17 actors, 15 static people, 5 parked + 4 moving vehicles, Prius sensors, shadows on) -->
<sdf version='1.9'>
  <world name="sentinel_street">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- No world-level plugins here — PX4 loads them at runtime via
         GZ_SIM_SERVER_CONFIG_PATH → server.config (see
         PX4-Autopilot/src/modules/simulation/gz_bridge/server.config).
         Matching PX4 default.sdf which also has zero inline plugins. -->

    <scene>
      <grid>false</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.55 0.65 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ======================== GROUND ======================== -->

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.25 0.28 0.22 1</ambient>
            <diffuse>0.3 0.33 0.27 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1</iyy><iyz>0</iyz><izz>1</izz>
          </inertia>
        </inertial>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- ======================== ROADS ======================== -->

    <!-- Main road east-west (Y=0 center, 10m wide) -->
    <model name="road_main">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>120 10 0.01</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cross road north-south (X=0 center, 8m wide) -->
    <model name="road_cross">
      <static>true</static>
      <pose>0 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>8 80 0.01</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sidewalk north side -->
    <model name="sidewalk_north">
      <static>true</static>
      <pose>0 7 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>120 3 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>120 3 0.1</size></box></geometry>
          <material>
            <ambient>0.7 0.68 0.62 1</ambient>
            <diffuse>0.75 0.73 0.67 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sidewalk south side -->
    <model name="sidewalk_south">
      <static>true</static>
      <pose>0 -7 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>120 3 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>120 3 0.1</size></box></geometry>
          <material>
            <ambient>0.7 0.68 0.62 1</ambient>
            <diffuse>0.75 0.73 0.67 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Center lane markings (dashed) -->
    <model name="lane_mark_1"><static>true</static><pose>-30 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_2"><static>true</static><pose>-24 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_3"><static>true</static><pose>-18 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_4"><static>true</static><pose>-12 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_5"><static>true</static><pose>-6 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_6"><static>true</static><pose>0 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_7"><static>true</static><pose>6 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_8"><static>true</static><pose>12 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_9"><static>true</static><pose>18 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_10"><static>true</static><pose>24 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="lane_mark_11"><static>true</static><pose>30 0 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>3 0.15 0.01</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>

    <!-- Crosswalk at intersection -->
    <model name="crosswalk_n"><static>true</static><pose>0 5.5 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>6 1.5 0.01</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>
    <model name="crosswalk_s"><static>true</static><pose>0 -5.5 0.01 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>6 1.5 0.01</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual></link></model>

    <!-- ======================== BUILDINGS ======================== -->

    <!-- Building A: Tall office tower (NE) -->
    <model name="building_office">
      <static>true</static>
      <pose>25 20 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 8 28</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 8 28</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.65 1</ambient>
            <diffuse>0.65 0.68 0.75 1</diffuse>
            <specular>0.8 0.8 0.85 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building B: Wide warehouse (NW) -->
    <model name="building_warehouse">
      <static>true</static>
      <pose>-22 22 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>18 10 7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>18 10 7</size></box></geometry>
          <material>
            <ambient>0.55 0.48 0.4 1</ambient>
            <diffuse>0.65 0.58 0.5 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building C: Residential block (SE) -->
    <model name="building_residential">
      <static>true</static>
      <pose>18 -18 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 8 14</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 8 14</size></box></geometry>
          <material>
            <ambient>0.72 0.65 0.55 1</ambient>
            <diffuse>0.82 0.75 0.65 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building D: Low shop (SW) -->
    <model name="building_shop">
      <static>true</static>
      <pose>-18 -16 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 6 5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 6 5</size></box></geometry>
          <material>
            <ambient>0.7 0.55 0.45 1</ambient>
            <diffuse>0.8 0.65 0.55 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building E: Thin tower (far east) -->
    <model name="building_tower">
      <static>true</static>
      <pose>40 15 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5 5 22</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5 5 22</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
            <specular>0.7 0.7 0.75 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building F: Garage (far west) -->
    <model name="building_garage">
      <static>true</static>
      <pose>-38 14 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 6 4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 6 4</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.48 1</ambient>
            <diffuse>0.6 0.6 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building G: Apartment (far south) -->
    <model name="building_apartment">
      <static>true</static>
      <pose>10 -30 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14 10 18</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>14 10 18</size></box></geometry>
          <material>
            <ambient>0.65 0.6 0.55 1</ambient>
            <diffuse>0.75 0.7 0.65 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Building H: Office (far north) -->
    <model name="building_office2">
      <static>true</static>
      <pose>-10 28 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 8 16</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 8 16</size></box></geometry>
          <material>
            <ambient>0.6 0.62 0.68 1</ambient>
            <diffuse>0.7 0.72 0.78 1</diffuse>
            <specular>0.6 0.6 0.65 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== PARKED VEHICLES (Fuel models) ======================== -->
    <!-- All vehicles sit at Z=0 on the ground plane.                                -->
    <!--                                                                             -->
    <!-- Internal mesh yaw offsets (derived from actual model.sdf visual rotations):  -->
    <!--   Hatchback: model SDF visual rot +π/2 reorients mesh -Y→+X, internal_yaw=0 -->
    <!--   Pickup:    model SDF visual rot -π/2 reorients mesh +Y→+X, internal_yaw=0 -->
    <!--   TruckBox:  mesh forward along +X, no rotation, internal_yaw=0             -->
    <!--   Bus:       mesh forward along +Y, no rotation, internal_yaw=+π/2          -->
    <!--   Prius:     collision boxes show front at -Y, no rotation, internal_yaw=-π/2-->
    <!--                                                                             -->
    <!-- SDF yaw = desired_heading - internal_yaw                                    -->

    <!-- Hatchback parked on north road, facing east (internal_yaw=0, yaw=0-0=0) -->
    <include>
      <name>hatchback_parked_1</name>
      <pose>10 3.5 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
    </include>

    <!-- Pickup parked on south road, facing west (internal_yaw=0, yaw=π-0=π) -->
    <include>
      <name>pickup_parked_1</name>
      <pose>-15 -3.5 0 0 0 3.14</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
    </include>

    <!-- TruckBox parked near warehouse, facing north (internal_yaw=0, yaw=π/2-0=π/2) -->
    <include>
      <name>truck_parked_1</name>
      <pose>-30 10 0 0 0 1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TruckBox</uri>
    </include>

    <!-- Bus parked far east, facing west (internal_yaw=+π/2, yaw=π-π/2=π/2) -->
    <include>
      <name>bus_parked_1</name>
      <pose>35 -10 0 0 0 1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bus</uri>
    </include>

    <!-- Prius parked near intersection, facing east (internal_yaw=-π/2, yaw=0-(-π/2)=π/2) -->
    <include>
      <name>prius_parked_1</name>
      <pose>28 -3 0 0 0 1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid with sensors</uri>
    </include>

    <!-- Hatchback parked on south road, facing east (internal_yaw=0, yaw=0) -->
    <include>
      <name>hatchback_parked_2</name>
      <pose>-5 -3.5 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
    </include>

    <!-- ======================== PEDESTRIAN Z-OFFSET REFERENCE ======================== -->
    <!-- Mingfei walk.dae actors:   Z=1.0 (mesh origin at body center Z≈0, feet at   -->
    <!--   Z≈-0.86 in mesh local frame. Z=1.0 puts feet at ~0.14m above ground.      -->
    <!--   Confirmed: walk.dae has 7845 verts, Z range -0.859 to +0.857, center 0.)  -->
    <!--   Official Fuel model demo uses Z=1.0 for all waypoints.                    -->
    <!--   Sidewalk top surface is at Z=0.1 (pose Z=0.05 + half-height 0.05).         -->
    <!--   At Z=1.0, feet at 0.14m — slightly above sidewalk, acceptable.            -->
    <!-- Male Visitor (include):    Z=0   (actor model demo uses Z=0, mesh at feet)  -->
    <!-- FemaleVisitor (include):   Z=0   (static model, visual at Z=0, mesh at feet)-->
    <!-- Walking person (include):  Z=0   (static model, visual at Z=-0.02, ≈feet)   -->
    <!-- All vehicles:              Z=0   (mesh origin at ground)                     -->
    <!-- ============================================================================ -->

    <!-- ======================== STANDING PEOPLE (Fuel static models, Z=0) ======================== -->
    <!-- Z=0 for all static person includes (mesh origin at feet).                    -->
    <!-- Mix of Male visitor, FemaleVisitor, Walking person for visual variety.       -->
    <!-- Walking person is a static model in a mid-stride pose (not animated).        -->

    <!-- Male visitor standing on north sidewalk near intersection -->
    <include>
      <name>person_male_1</name>
      <pose>-5 8.5 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor</uri>
    </include>

    <!-- Female visitor standing on south sidewalk -->
    <include>
      <name>person_female_1</name>
      <pose>8 -8.5 0 0 0 3.14</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FemaleVisitor</uri>
    </include>

    <!-- Male visitor standing near bus stop (far east) -->
    <include>
      <name>person_male_2</name>
      <pose>33 -8.5 0 0 0 1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor</uri>
    </include>

    <!-- Female visitor near intersection SE corner -->
    <include>
      <name>person_female_2</name>
      <pose>3 -6.5 0 0 0 0.78</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FemaleVisitor</uri>
    </include>

    <!-- Male visitor on far west sidewalk -->
    <include>
      <name>person_male_3</name>
      <pose>-30 8.5 0 0 0 3.14</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor</uri>
    </include>

    <!-- Walking person on north sidewalk mid-block (static walking pose) -->
    <include>
      <name>person_walk_1</name>
      <pose>20 8.5 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
    </include>

    <!-- Walking person on south sidewalk near intersection -->
    <include>
      <name>person_walk_2</name>
      <pose>-8 -8.5 0 0 0 3.14</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
    </include>

    <!-- Female visitor on north sidewalk far east -->
    <include>
      <name>person_female_3</name>
      <pose>25 8.5 0 0 0 1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FemaleVisitor</uri>
    </include>

    <!-- Male visitor on south sidewalk far west -->
    <include>
      <name>person_male_4</name>
      <pose>-25 -8.5 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor</uri>
    </include>

    <!-- Walking person near crosswalk south side -->
    <include>
      <name>person_walk_3</name>
      <pose>1 -6 0 0 0 -1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
    </include>

    <!-- ======================== WALKING PEDESTRIANS (Mingfei walk.dae, Z=1.0) ======================== -->
    <!-- Z=1.0 required: Mingfei walk.dae mesh origin at body center Z≈0, feet at    -->
    <!--   Z≈-0.86 in mesh local frame. Z=1.0 places feet at ~0.14m above ground.    -->
    <!-- Walking speed: 0.7-1.3 m/s (natural pedestrian pace).                        -->
    <!-- Waypoint yaw faces direction of travel (0=east, π/2=north, π=west, -π/2=south) -->
    <!-- Turn waypoints: 1-2s pause with yaw change for smooth direction transitions. -->
    <!-- Road layout: main road Y=-5..5, sidewalks Y~8.5 (N), Y~-8.5 (S)             -->

    <!-- Pedestrian 1: East along north sidewalk and back (~1.0 m/s, Z=1.0) -->
    <actor name="pedestrian_1">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.5">
          <waypoint><time>0</time><pose>-15 8.5 1.0 0 0 0</pose></waypoint>
          <waypoint><time>12</time><pose>-5 8.3 1.0 0 0 0</pose></waypoint>
          <waypoint><time>25</time><pose>5 8.5 1.0 0 0 0</pose></waypoint>
          <waypoint><time>37</time><pose>15 8.4 1.0 0 0 0</pose></waypoint>
          <waypoint><time>39</time><pose>15 8.4 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>51</time><pose>5 8.6 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>64</time><pose>-5 8.4 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>77</time><pose>-15 8.5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>79</time><pose>-15 8.5 1.0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Pedestrian 2: West along south sidewalk and back (~1.0 m/s, Z=1.0) -->
    <actor name="pedestrian_2">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>2.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.5">
          <waypoint><time>0</time><pose>12 -8.5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>9</time><pose>5 -8.4 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>19</time><pose>-2 -8.6 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>29</time><pose>-10 -8.5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>31</time><pose>-10 -8.5 1.0 0 0 0</pose></waypoint>
